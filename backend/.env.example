# ===== CampusMind AI - Backend Environment =====

# --- Core ---
# In production set ENVIRONMENT=production. The app then refuses to start unless
# SECRET_KEY is set to a real random value (32+ characters, not the placeholder
# below). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value. Development and tests keep working with this placeholder.
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Local dev default (no setup needed). For production, point this to your
# Supabase Postgres connection string instead, e.g.:
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=sqlite:///./campusmind.db

# --- AI Provider Abstraction ---
# One of: gemini | openai | claude | mock
AI_PROVIDER=gemini
AI_MODEL_NAME=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embedding Provider Abstraction ---
# One of: gemini | openai | local
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL_NAME=gemini-embedding-2

# --- CORS ---
# Comma-separate to allow several origins, e.g. a custom domain plus *.vercel.app.
FRONTEND_ORIGIN=http://localhost:5173

# --- Scheduled reminders ---
# Shared secret for POST /api/notifications/process-reminders (X-Cron-Secret
# header). Leave empty to disable the header path; admins can still trigger
# it from a signed-in session. Use a long random value in production.
CRON_SECRET=

# --- Uploads ---
MAX_UPLOAD_MB=25
UPLOAD_DIR=./uploads

# --- Cloudinary (profile pictures AND document/notification attachments) ---
# Free tier: https://cloudinary.com/users/register/free
# Find these three values on your Cloudinary dashboard after signup.
# Profile image upload is disabled (returns a clear error) until all three
# are set - there is no local-disk fallback for avatars, by design, since
# they need a stable public URL the frontend can render from anywhere.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_AVATAR_MB=5

# Web Push (background notifications). Generate with: python scripts/generate_vapid_keys.py
# Leave empty to disable push; in-app notifications and polling keep working.
# VAPID_PRIVATE_KEY is a secret: backend only, never a VITE_* variable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
